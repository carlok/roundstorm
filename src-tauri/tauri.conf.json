{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roundstorm",
  "version": "0.1.0",
  "identifier": "dev.roundstorm.app",
  "build": {
    "frontendDist": "../dist-web",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Roundstorm",
        "width": 1360,
        "height": 880,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-server": "dist-server"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
