{
  "name": "roundstorm",
  "version": "0.1.0",
  "description": "Local-first multi-agent research deliberation: persistent AI researchers argue a hard question for N rounds.",
  "author": "Carlo Perassi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlok/roundstorm.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n daemon,web -c cyan,magenta \"npm:dev:daemon\" \"npm:dev:web\"",
    "dev:daemon": "tsx watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/src/deliberation/*.test.ts server/src/adapters/*.test.ts server/src/sqlite/*.test.ts web/src/lib/*.test.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "npm run build && tauri build && npm run check:arch",
    "coverage": "tsx --test --experimental-test-coverage server/src/deliberation/*.test.ts server/src/adapters/*.test.ts server/src/sqlite/*.test.ts web/src/lib/*.test.ts",
    "check:arch": "node scripts/check-arch.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.5"
  }
}
